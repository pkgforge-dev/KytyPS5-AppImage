#!/bin/sh

dir="$DATADIR/KytyPS5"

if [ -f "$APPDIR/sharun" ] &&
	[ -f "$APPDIR/shared/bin/launcher" ] &&
	[ -f "$APPDIR/shared/bin/kyty_emulator" ] &&
	mkdir -p "$dir/shared/bin" 2>/dev/null &&
	cd "$dir" 2>/dev/null; then

	cmp -s "$APPDIR/sharun" ./sharun 2>/dev/null || cp -f "$APPDIR/sharun" ./sharun || :
	for f in .env .preload; do
		[ -f "$APPDIR/$f" ] && cp -f "$APPDIR/$f" ./$f || :
	done
	for d in lib share etc plugins; do
		[ -e "$APPDIR/$d" ] && ln -sfn "$APPDIR/$d" ./$d || :
	done

	cmp -s "$APPDIR/shared/bin/launcher" ./shared/bin/launcher 2>/dev/null ||
		cp -f "$APPDIR/shared/bin/launcher" ./shared/bin/launcher || :
	cmp -s "$APPDIR/shared/bin/kyty_emulator" ./shared/bin/kyty_emulator 2>/dev/null ||
		cp -f "$APPDIR/shared/bin/kyty_emulator" ./shared/bin/kyty_emulator || :

	rm -f ./launcher ./kyty_emulator || :
	ln -f ./sharun ./launcher || :
	ln -f ./sharun ./kyty_emulator || :

	if [ -f "$APPDIR/bin/qt.conf" ]; then
		cp -f "$APPDIR/bin/qt.conf" ./qt.conf || :
		sed -i "s|^Prefix[[:space:]]*=[[:space:]]*\.\./|Prefix = $APPDIR/bin/../|" ./qt.conf || :
	fi

	if [ -x ./launcher ]; then
		exec "$dir/launcher" "$@"
	fi
fi
