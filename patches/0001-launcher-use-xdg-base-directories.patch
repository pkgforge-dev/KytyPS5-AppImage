# Use the XDG base directories for the launcher config, the compatibility
# database, cheat patches and the emulator writable data instead of writing
# next to the binaries. Adds src/launcher/include/appPaths.h.
#
diff --git a/src/launcher/include/appPaths.h b/src/launcher/include/appPaths.h
new file mode 100644
index 0000000..92120d9
--- /dev/null
+++ b/src/launcher/include/appPaths.h
@@ -0,0 +1,34 @@
+#ifndef LAUNCHER_INCLUDE_APP_PATHS_H_
+#define LAUNCHER_INCLUDE_APP_PATHS_H_
+
+#include <QDir>
+#include <QStandardPaths>
+#include <QString>
+
+// Writable locations that follow the XDG Base Directory Specification.
+// https://specifications.freedesktop.org/basedir-spec/latest/
+namespace AppPaths {
+
+static constexpr char APP_DIR_NAME[] = "KytyPS5";
+
+inline QString DataDir() {
+	const auto base = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation);
+	return QDir(base).filePath(QString::fromLatin1(APP_DIR_NAME));
+}
+
+inline QString RuntimeDir() {
+	auto base = QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation);
+	if (base.isEmpty()) {
+		base = QDir::tempPath();
+	}
+	return QDir(base).filePath(QString::fromLatin1(APP_DIR_NAME));
+}
+
+inline QString EnsureDir(const QString& dir) {
+	QDir().mkpath(dir);
+	return dir;
+}
+
+} // namespace AppPaths
+
+#endif
